DB_HOST=localhost
DB_PORT=5432
DB_NAME=olist_analytics
DB_USER=postgres
DB_PASSWORD=replace_with_your_password

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
